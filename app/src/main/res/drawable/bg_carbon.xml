<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/carbon_bg" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="@color/carbon_line_soft"
                android:centerColor="@color/carbon_bg"
                android:endColor="@color/carbon_line_soft" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#12000000"
                android:centerColor="#00111111"
                android:endColor="#12000000" />
        </shape>
    </item>
</layer-list>
