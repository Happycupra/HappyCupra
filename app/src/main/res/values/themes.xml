<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.CarLauncher" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cockpit_accent</item>
        <item name="colorOnPrimary">@color/cockpit_bg</item>
        <item name="colorSecondary">@color/cockpit_accent</item>
        <item name="colorSurface">@color/cockpit_surface</item>
        <item name="colorOnSurface">@color/cockpit_text_primary</item>
        <item name="colorSurfaceVariant">@color/cockpit_surface_alt</item>
        <item name="colorOnSurfaceVariant">@color/cockpit_text_secondary</item>
        <item name="colorError">@color/cockpit_badge</item>
        <item name="android:colorBackground">@color/cockpit_bg</item>
        <item name="android:textColorPrimary">@color/cockpit_text_primary</item>
        <item name="android:textColorSecondary">@color/cockpit_text_secondary</item>
        <item name="android:windowBackground">@color/cockpit_bg</item>
    </style>

    <!-- The HOME activity itself. Opaque background: most head units have no wallpaper. -->
    <style name="Theme.CarLauncher.Home">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/cockpit_bg</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Theme.CarLauncher.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/cockpit_surface</item>
        <item name="colorOnSurface">@color/cockpit_text_primary</item>
        <item name="colorPrimary">@color/cockpit_accent</item>
    </style>

    <!-- Tabular figures so the clock and speedometer do not shift width as digits change. -->
    <style name="Text.Gauge" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/cockpit_text_primary</item>
    </style>

    <style name="Text.Caption" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textSize">@dimen/gauge_caption_text</item>
        <item name="android:textColor">@color/cockpit_text_dim</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Theme.CarLauncher.RedCarbon" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/carbon_red_bright</item>
        <item name="colorOnPrimary">@color/carbon_bg</item>
        <item name="colorSecondary">@color/carbon_red</item>
        <item name="colorOnSecondary">@color/carbon_text</item>
        <item name="colorSurface">@color/carbon_surface</item>
        <item name="colorOnSurface">@color/carbon_text</item>
        <item name="colorSurfaceVariant">@color/carbon_surface_alt</item>
        <item name="colorOnSurfaceVariant">@color/carbon_text_secondary</item>
        <item name="colorOutline">@color/carbon_red_dark</item>
        <item name="colorError">@color/carbon_red_bright</item>
        <item name="android:colorBackground">@color/carbon_bg</item>
        <item name="android:textColorPrimary">@color/carbon_text</item>
        <item name="android:textColorSecondary">@color/carbon_text_secondary</item>
        <item name="android:windowBackground">@drawable/bg_carbon</item>
    </style>

    <style name="Theme.CarLauncher.RedCarbon.Home" parent="Theme.CarLauncher.RedCarbon">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@drawable/bg_carbon</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

</resources>
