<?xml version="1.0" encoding="utf-8"?>
<!--
  Single-activity launcher. The app drawer is an overlay in this same layout rather than a
  fragment or second activity: opening it is then a visibility flip with no transaction, no
  window animation and no risk of the home task stacking.
-->
<com.carlauncherc.launcher.ui.ImmersiveConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cockpit_bg">

    <!-- ============================ DASHBOARD ============================ -->
    <LinearLayout
        android:id="@+id/dashboard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding"
        app:layout_constraintBottom_toTopOf="@+id/dockStrip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Gauge row; HomeActivity can reorder or resize the three existing gauges. -->
        <LinearLayout
            android:id="@+id/dashboardGaugeRow"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Speedometer. Tapping anywhere on it toggles KM/H <-> MPH. -->
            <LinearLayout
                android:id="@+id/gaugeSpeed"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_gauge"
                android:clickable="true"
                android:contentDescription="@string/speed"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/textSpeed"
                    style="@style/Text.Gauge"
                    android:layout_width="match_parent"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:layout_height="wrap_content"
                    android:text="@string/speed_placeholder"
                    android:textColor="@color/cockpit_speed"
                    android:textSize="@dimen/speed_text" />

                <TextView
                    android:id="@+id/textSpeedUnit"
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_kmh"
                    android:textColor="@color/cockpit_text_secondary"
                    android:textSize="@dimen/speed_unit_text" />

                <TextView
                    android:id="@+id/textSpeedStatus"
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/gps_acquiring" />
            </LinearLayout>

            <Space
                android:layout_width="@dimen/gap"
                android:layout_height="match_parent" />

            <!-- Clock. TextClock ticks itself from the system time broadcasts, so there is no
                 Handler loop burning CPU on a head unit that is powered all day. -->
            <LinearLayout
                android:id="@+id/gaugeClock"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.4"
                android:background="@drawable/bg_gauge"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <TextClock
                    android:id="@+id/clockTime"
                    style="@style/Text.Gauge"
                    android:layout_width="match_parent"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:textSize="@dimen/clock_text"
                    tools:text="12:47" />

                <TextClock
                    android:id="@+id/clockDay"
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:format12Hour="EEEE"
                    android:format24Hour="EEEE"
                    android:textColor="@color/cockpit_accent"
                    android:textSize="@dimen/date_text"
                    tools:text="TUESDAY" />

                <TextClock
                    android:id="@+id/clockDate"
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_height="wrap_content"
                    android:format12Hour="d MMMM yyyy"
                    android:format24Hour="d MMMM yyyy"
                    android:textAllCaps="false"
                    android:textSize="@dimen/date_text"
                    tools:text="16 September 2026" />
            </LinearLayout>

            <Space
                android:layout_width="@dimen/gap"
                android:layout_height="match_parent" />

            <!-- Round Qibla compass. The legacy text fields stay in the hierarchy (GONE) so
                 the existing dashboard renderer remains source-compatible. -->
            <LinearLayout
                android:id="@+id/gaugeCompass"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_gauge"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp">

                <com.carlauncherc.launcher.ui.QiblaCompassView
                    android:id="@+id/qiblaCompass"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:contentDescription="Qibla compass" />

                <TextView
                    android:id="@+id/textCardinal"
                    style="@style/Text.Gauge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/speed_placeholder"
                    android:textSize="@dimen/cardinal_text"
                    android:visibility="gone"
                    tools:text="NE" />

                <TextView
                    android:id="@+id/textDegrees"
                    style="@style/Text.Gauge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/cockpit_text_secondary"
                    android:textSize="@dimen/degrees_text"
                    android:visibility="gone"
                    tools:text="43°" />

                <TextView
                    android:id="@+id/textHeadingSource"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/heading"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:id="@+id/quickCardsSpacer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/gap" />

        <!-- ========================= QUICK CARDS ========================= -->
        <LinearLayout
            android:id="@+id/quickCardsRow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/card_height"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cardNav"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.8"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/iconNav"
                    android:layout_width="@dimen/card_icon"
                    android:layout_height="@dimen/card_icon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_navigation" />

                <TextView
                    android:id="@+id/titleNav"
                    style="@style/Text.Gauge"
                    android:layout_width="match_parent"
                    android:maxLines="1"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:text="@string/card_navigation"
                    android:textSize="@dimen/card_label_text" />

                <TextView
                    android:id="@+id/subtitleNav"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="@string/card_not_set"
                    android:textColor="@color/cockpit_text_dim"
                    android:textSize="@dimen/card_sub_text" />
            </LinearLayout>

            <Space
                android:layout_width="@dimen/gap"
                android:layout_height="match_parent" />

            <FrameLayout
                android:id="@+id/cardMusic"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.7"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:padding="9dp">

                <LinearLayout
                    android:id="@+id/musicTopContent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="@dimen/music_visualizer_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/albumArtContainer"
                    android:layout_width="@dimen/album_art_size"
                    android:layout_height="@dimen/album_art_size">

                    <ImageView
                        android:id="@+id/imageAlbumArt"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_dock_item"
                        android:contentDescription="@string/media_album_art"
                        android:padding="8dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_music" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:id="@+id/musicInfoColumn"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/titleMusic"
                        style="@style/Text.Gauge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/card_music"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/subtitleMusic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/card_not_set"
                        android:textColor="@color/cockpit_text_dim"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/textNowPlayingTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/media_title_unavailable"
                        android:textColor="@color/cockpit_text_primary"
                        android:textSize="@dimen/music_title_text"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textNowPlayingArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/cockpit_text_secondary"
                        android:textSize="@dimen/music_artist_text" />

                    <ProgressBar
                        android:id="@+id/musicProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="5dp"
                        android:max="1000"
                        android:progress="0"
                        android:progressBackgroundTint="@color/cockpit_surface_alt"
                        android:progressTint="@color/cockpit_accent" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textElapsed"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/media_time_zero"
                            android:textColor="@color/cockpit_text_dim"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/textDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/media_time_zero"
                            android:textColor="@color/cockpit_text_dim"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/musicControls"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/music_control_height"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btnMusicPrevious"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:scaleType="fitCenter"
                            android:background="@drawable/bg_dock_item"
                            android:contentDescription="@string/media_previous"
                            android:padding="10dp"
                            android:src="@drawable/ic_media_previous" />

                        <ImageButton
                            android:id="@+id/btnMusicPlayPause"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:scaleType="fitCenter"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_dock_item"
                            android:contentDescription="@string/media_play_pause"
                            android:padding="10dp"
                            android:src="@drawable/ic_media_play" />

                        <ImageButton
                            android:id="@+id/btnMusicNext"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:scaleType="fitCenter"
                            android:background="@drawable/bg_dock_item"
                            android:contentDescription="@string/media_next"
                            android:padding="10dp"
                            android:src="@drawable/ic_media_next" />
                    </LinearLayout>
                </LinearLayout>
                </LinearLayout>

                <com.carlauncherc.launcher.ui.PlaybackEqualizerView
                    android:id="@+id/playbackEqualizer"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/music_visualizer_height"
                    android:layout_gravity="bottom"
                    android:contentDescription="@string/media_visualizer"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ============================== DRAWER ============================== -->
    <LinearLayout
        android:id="@+id/drawerContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/cockpit_scrim"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/dockStrip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_search"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search" />

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@null"
                    android:hint="@string/search_apps"
                    android:imeOptions="actionSearch|flagNoExtractUi"
                    android:inputType="text"
                    android:maxLines="1"
                    android:minHeight="56dp"
                    android:singleLine="true"
                    android:textColor="@color/cockpit_text_primary"
                    android:textColorHint="@color/cockpit_text_dim"
                    android:textSize="@dimen/search_text"
                    android:autofillHints="" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnCloseDrawer"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_dock_item"
                android:contentDescription="@string/close_drawer"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/appGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="8dp"
                android:scrollbars="vertical" />

            <TextView
                android:id="@+id/drawerEmpty"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/loading_apps"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- =============================== DOCK =============================== -->
    <include
        android:id="@+id/dockStrip"
        layout="@layout/view_dock"
        android:layout_width="0dp"
        android:layout_height="@dimen/dock_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</com.carlauncherc.launcher.ui.ImmersiveConstraintLayout>
